#!/bin/sh /etc/rc.common
# sms2discord: two-way SMS <-> Discord bridge (starts after smstools3, START=94)

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled webhook_url

	config_load sms2discord
	config_get_bool enabled main enabled 0
	config_get webhook_url main webhook_url
	[ "$enabled" = 1 ] || return 0
	if [ -z "$webhook_url" ]; then
		echo "sms2discord: no webhook_url set, run 'sms2discord setup' or use LuCI" >&2
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/bin/sms2discord run
	# restart when the config changes (LuCI "Save & Apply", uci commit)
	procd_set_param file /etc/config/sms2discord
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "sms2discord"
}
