#!/bin/sh /etc/rc.common
# sms2discord: forward SMS to Discord (starts after smstools3, START=94)

START=99
STOP=10
USE_PROCD=1

start_service() {
	if [ ! -s /etc/sms2discord/config ]; then
		echo "sms2discord: not configured, run 'sms2discord setup'" >&2
		return 0
	fi
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/bin/sms2discord run
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}
